---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

const groups = [
  { cat: 'Writing & Content', prompts: [
    'Act as an expert copywriter. Write 5 punchy headline variations for [product], each under 10 words, aimed at [audience].',
    'Rewrite the following text to be clearer and more concise without losing meaning. Keep the tone professional: [paste text].',
    'Turn these bullet points into a smooth 150-word intro paragraph for a blog post about [topic]: [bullets].',
    'Summarize this article in 5 key takeaways a busy reader can scan in 20 seconds: [paste article].',
    'Write a 300-word product description for [product] that highlights benefits over features and ends with a soft call to action.',
    'Give me 10 blog post title ideas about [topic] that are specific, curiosity-driven, and under 60 characters.',
  ]},
  { cat: 'Marketing & Social', prompts: [
    'Create a 5-email welcome sequence for a [type] business. For each email give a subject line and 2-sentence summary.',
    'Write 5 short social captions for [product] in a friendly, non-salesy tone, each with a relevant hook and 3 hashtags.',
    'Act as a growth marketer. List 10 low-budget marketing tactics for a brand-new [type] website with no audience yet.',
    'Draft a landing page above-the-fold: headline, subheadline, and 3 benefit bullets for [product].',
    'Generate 7 content ideas for [niche] that answer real questions people search for, phrased as article titles.',
    'Write a cold outreach message (under 90 words) to [type of person] offering [value], friendly and specific.',
  ]},
  { cat: 'Coding & Tech', prompts: [
    'Explain this code line by line as if teaching a junior developer, then suggest one improvement: [paste code].',
    'Write a [language] function that [does X]. Include comments and a short example of how to call it.',
    'Review this function for bugs, edge cases, and readability. List issues by severity: [paste code].',
    'Convert this [language A] snippet to [language B], keeping behavior identical: [paste code].',
    'Draft clear commit messages for these changes following conventional commits: [describe changes].',
    'Act as a debugger. Given this error and code, list the 3 most likely causes and how to test each: [error + code].',
  ]},
  { cat: 'Productivity & Work', prompts: [
    'Turn this messy meeting transcript into clear action items with owners and due dates: [paste notes].',
    'Draft a polite email declining [request] while keeping the relationship positive. Under 100 words.',
    'Break this big goal into a 7-step plan I can start today: [goal].',
    'Act as my assistant. Prioritize this to-do list using impact vs effort and explain the order: [list].',
    'Write a 1-paragraph project status update for stakeholders from these notes: [notes].',
    'Give me 5 thoughtful questions to ask in a [role] interview that reveal how they think.',
  ]},
  { cat: 'Images & Creative', prompts: [
    'Write a detailed image-generation prompt for [subject]: describe style, lighting, mood, composition, and color palette.',
    'Give me 5 variations of a logo concept brief for a [type] brand, each with a different vibe.',
    'Describe a cinematic scene for [topic] I can feed to an AI video tool: setting, camera movement, lighting, mood.',
    'Brainstorm 10 visual metaphors to illustrate the concept of [abstract idea].',
    'Write alt text (under 125 chars) for an image showing [describe image], optimized for accessibility and SEO.',
    'Create a color palette (5 hex codes) for a [mood] [type] brand and explain what each color communicates.',
  ]},
];
---
<Base
  title="50 Free AI Prompts You Can Copy & Paste (2026)"
  description="A free, copy-and-paste library of the best AI prompts for writing, marketing, coding, productivity and images. No sign-up needed."
>
  <Header />
  <main class="flex-1">
    <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <div class="text-center mb-8">
        <h1 class="font-display font-black text-3xl sm:text-5xl text-brand-white mb-3">
          50 Free <span class="text-brand-cyan">AI Prompts</span> to Copy & Paste
        </h1>
        <p class="text-brand-dim text-lg">Tested prompts for ChatGPT, Claude, Gemini & more. Just swap the [brackets] and go.</p>
      </div>

      {groups.map(g => (
        <div class="mb-8">
          <h2 class="font-display font-bold text-xl text-brand-cyan mb-3">{g.cat}</h2>
          <div class="space-y-2">
            {g.prompts.map(p => (
              <div class="flex items-start gap-3 rounded-xl border border-brand-border bg-brand-surface/60 p-3">
                <p class="prompt-text text-brand-dim text-sm flex-1">{p}</p>
                <button class="copy-btn flex-shrink-0 text-xs font-bold text-brand-cyan border border-brand-cyan/40 rounded-lg px-2.5 py-1 hover:bg-brand-cyan/10 transition-colors">Copy</button>
              </div>
            ))}
          </div>
        </div>
      ))}

      <p class="text-brand-dim text-sm text-center mb-8">
        Want more structured image-prompt templates? See our guide to the
        <a href="/gpt-image2-free-prompt-library/" class="text-brand-cyan hover:underline">free GPT-Image 2 prompt library</a>.
      </p>

      <NewsletterSignup />
    </section>
  </main>
  <Footer />

  <script>
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.parentElement.querySelector('.prompt-text').textContent;
        navigator.clipboard.writeText(text).then(() => {
          const old = btn.textContent; btn.textContent = 'Copied ✓';
          setTimeout(() => { btn.textContent = old; }, 1500);
        });
      });
    });
  </script>
</Base>
