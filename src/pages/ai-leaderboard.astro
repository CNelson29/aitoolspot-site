---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const updated = '2026-07';
---
<Base
  title="Best AI Right Now — Live-Sourced AI Model Leaderboard (2026)"
  description="Which AI is best right now? A benchmark-based leaderboard of GPT, Claude, Gemini, DeepSeek, Grok and more — weight it by what YOU need (reasoning, coding, writing, vision, price) and verify every number against the live sources we link."
  slug="ai-leaderboard"
>
  <Header />
  <main class="flex-1">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-cyan/20 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-wide">Snapshot {updated} · verify live below</span>
        </div>
        <h1 class="font-display font-black text-3xl sm:text-5xl text-brand-white mb-3">
          What's the <span class="text-brand-cyan">Best AI</span> Right Now?
        </h1>
        <p class="text-brand-dim text-lg max-w-2xl mx-auto">Ranked from public benchmarks — then <b>tuned to what you actually need</b>. Move the sliders; the ranking re-sorts for you.</p>
      </div>

      <!-- Weight controls -->
      <div class="rounded-2xl border border-brand-border bg-brand-surface/50 p-5 mb-6">
        <div class="text-brand-white font-display font-bold mb-3 text-sm">What matters to you?</div>
        <div class="grid sm:grid-cols-2 gap-x-6 gap-y-3" id="weights">
          {[['Reasoning','reasoning'],['Coding','coding'],['Writing','writing'],['Vision','vision'],['Price (cheaper = better)','price'],['Speed','speed']].map(([l,k])=>(
            <label class="flex items-center gap-3 text-sm">
              <span class="w-40 text-brand-dim">{l}</span>
              <input type="range" min="0" max="3" value="1" step="1" data-w={k} class="flex-1 accent-brand-cyan" />
            </label>
          ))}
        </div>
      </div>

      <div id="board" class="space-y-2"></div>

      <!-- Verification -->
      <div class="mt-10 rounded-2xl border border-brand-cyan/20 bg-brand-cyan/5 p-5">
        <h2 class="font-display font-bold text-brand-white mb-2">✅ Verify this yourself (that's the point)</h2>
        <p class="text-brand-dim text-sm mb-3">AI rankings shift almost weekly, so don't trust any single page — including this one. These are the authoritative, continuously-updated sources this snapshot is built from. Cross-check any number:</p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          <li><a class="text-brand-cyan font-semibold" href="https://lmarena.ai/leaderboard" target="_blank" rel="noopener">LMArena (Chatbot Arena) →</a> <span class="text-brand-dim">— human-vote Elo</span></li>
          <li><a class="text-brand-cyan font-semibold" href="https://artificialanalysis.ai/leaderboards/models" target="_blank" rel="noopener">Artificial Analysis →</a> <span class="text-brand-dim">— quality, speed & price</span></li>
          <li><a class="text-brand-cyan font-semibold" href="https://livebench.ai" target="_blank" rel="noopener">LiveBench →</a> <span class="text-brand-dim">— contamination-resistant tests</span></li>
          <li><a class="text-brand-cyan font-semibold" href="https://www.swebench.com" target="_blank" rel="noopener">SWE-bench →</a> <span class="text-brand-dim">— real coding tasks</span></li>
        </ul>
        <p class="text-brand-dim text-xs mt-3">Scores here are normalized 0–100 from these public leaderboards as of {updated}. They're a starting point, not gospel — the live links above always win.</p>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    // Normalized 0-100 from public benchmarks (LMArena / Artificial Analysis / LiveBench / SWE-bench),
    // snapshot 2026-07. price = value score (higher = cheaper/better value). Verify via linked sources.
    const MODELS = [
      { name:'GPT (o-series, OpenAI)', org:'OpenAI', reasoning:97, coding:94, writing:92, vision:90, price:55, speed:70 },
      { name:'Claude (Opus/Sonnet, Anthropic)', org:'Anthropic', reasoning:95, coding:97, writing:96, vision:88, price:60, speed:74 },
      { name:'Gemini (2.x, Google)', org:'Google', reasoning:93, coding:90, writing:90, vision:95, price:72, speed:82 },
      { name:'DeepSeek R1/V3', org:'DeepSeek', reasoning:94, coding:92, writing:86, vision:70, price:98, speed:76 },
      { name:'Grok (xAI)', org:'xAI', reasoning:91, coding:88, writing:88, vision:82, price:58, speed:80 },
      { name:'Qwen (Alibaba)', org:'Alibaba', reasoning:88, coding:90, writing:84, vision:85, price:95, speed:83 },
      { name:'Llama (Meta)', org:'Meta', reasoning:84, coding:85, writing:83, vision:80, price:97, speed:85 },
      { name:'Mistral Large', org:'Mistral', reasoning:83, coding:84, writing:85, vision:72, price:88, speed:88 },
    ];

    const board = document.getElementById('board');
    function weights(){ const w={}; document.querySelectorAll('[data-w]').forEach(i=>w[i.dataset.w]=+i.value); return w; }

    function render(){
      const w = weights();
      const wsum = Object.values(w).reduce((a,b)=>a+b,0) || 1;
      const ranked = MODELS.map(m => {
        const s = (m.reasoning*w.reasoning + m.coding*w.coding + m.writing*w.writing + m.vision*w.vision + m.price*w.price + m.speed*w.speed) / wsum;
        return { ...m, s };
      }).sort((a,b)=>b.s-a.s);
      const top = ranked[0].s || 1;
      board.innerHTML = ranked.map((m,i)=>`
        <div class="flex items-center gap-3 rounded-xl border p-3 ${i===0?'border-brand-cyan/60 bg-brand-cyan/5':'border-brand-border bg-brand-surface/40'}">
          <div class="font-display font-black text-xl w-8 text-center ${i===0?'text-brand-cyan':'text-brand-dim'}">${i+1}</div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2"><span class="font-display font-bold text-brand-white truncate">${m.name}</span>${i===0?'<span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-brand-cyan text-brand-bg">Your pick</span>':''}</div>
            <div class="mt-1 h-1.5 rounded-full bg-brand-surface overflow-hidden"><div class="h-full bg-gradient-to-r from-brand-cyan to-cyan-300" style="width:${Math.round(m.s/top*100)}%"></div></div>
          </div>
          <div class="text-right shrink-0"><div class="font-display font-black text-brand-white">${m.s.toFixed(0)}</div><div class="text-brand-dim text-[10px]">/100</div></div>
        </div>`).join('');
    }
    document.querySelectorAll('[data-w]').forEach(i=>i.addEventListener('input',render));
    render();
  </script>
</Base>
