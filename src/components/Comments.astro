---
// Real user comments via Giscus (GitHub Discussions) — no database needed.
// Requires the "giscus" GitHub App installed on CNelson29/aitoolspot-site (public repo).
---
<section class="mt-10 pt-8 border-t border-brand-border/50">
  <h2 class="font-display font-bold text-xl text-white mb-5">Discussion</h2>
  <script
    src="https://giscus.app/client.js"
    data-repo="CNelson29/aitoolspot-site"
    data-repo-id="R_kgDOSON5VA"
    data-category="General"
    data-category-id="DIC_kwDOSON5VM4DEmX2"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="dark"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>
